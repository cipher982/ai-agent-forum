[Unit]
Description=Airlock isolated VM HTTP ingress from Clifford
After=network-online.target tailscaled.service libvirtd.service
Wants=network-online.target

[Service]
User=nobody
Group=nogroup
ExecStart=/usr/bin/socat TCP4-LISTEN:18081,bind=100.125.140.78,reuseaddr,fork,max-children=64,range=100.118.94.100/32 TCP4:192.168.127.2:8080,connect-timeout=5
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
MemoryMax=64M
TasksMax=70
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
